# ============================================================
# AI YOUTUBE SHORTS GENERATOR CONFIGURATION
# ============================================================

# Mode API (MuAPI - opsional jika memakai cloud MuAPI)
MUAPI_API_KEY=your_muapi_key_here

# ------------------------------------------------------------
# LOCAL MODE (--mode local)
# ------------------------------------------------------------

# 1. Audio-to-Text Transkripsi (gemini atau whisper)
TRANSCRIBER_PROVIDER=gemini

# Google Gemini Settings (Transkripsi Audio / Highlight)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TRANSCRIBER_MODEL=gemini-3.5-transcribe

# 2. Highlight Selection (LLM Provider)
LLM_PROVIDER=openai

# OpenAI / APMIX Settings (OpenAI-compatible)
OPENAI_API_KEY=your_apmix_or_openai_key_here
OPENAI_BASE_URL=https://api.apmix.ai/v1
OPENAI_MODEL=gpt-4o-mini

# Faster-Whisper Settings (Hanya digunakan jika TRANSCRIBER_PROVIDER=whisper)
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto

# Output directory
LOCAL_OUTPUT_DIR=output

# Auto-cleanup video mentahan YouTube setelah selesai render klip (Hemat Storage, default: true)
AUTO_DELETE_SOURCE_VIDEO=true
